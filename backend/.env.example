# --- サーバー ---
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# --- DB(MySQL / XAMPP) ---
# XAMPPのMySQLはデフォルトで user=root, password=(空), port=3306
# phpMyAdmin等で事前に "live_streaming_app" データベースを作成しておくこと
DATABASE_URL="mysql://root:@localhost:3306/live_streaming_app_v2"

# --- 認証 ---
JWT_SECRET=change-me-to-a-random-secret

# --- mediasoup ---
ANNOUNCED_IP=127.0.0.1
RTC_MIN_PORT=10000
RTC_MAX_PORT=10100

# --- YouTube連携 ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=
USE_MOCK=false
